NODE_ENV=development
SERVICE_NAME=example-service
PORT=3001
DATABASE_URL=postgresql://app:app@localhost:5433/example?schema=public
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=example-service
KAFKA_GROUP_ID=example-service
LOG_LEVEL=info

# Seguridad
CORS_ORIGIN=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
INTERNAL_API_KEY=

# Observabilidad (tracing opcional; vacío = OpenTelemetry desactivado)
OTEL_EXPORTER_OTLP_ENDPOINT=
