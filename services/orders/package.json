{
  "name": "@bjm/orders-service",
  "version": "0.1.0",
  "private": true,
  "description": "Orders microservice (command side of the OMS saga)",
  "main": "dist/main.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bjm/contracts": "*",
    "@bjm/shared": "*",
    "@prisma/client": "^5.22.0",
    "fastify": "^4.28.0",
    "kafkajs": "^2.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
