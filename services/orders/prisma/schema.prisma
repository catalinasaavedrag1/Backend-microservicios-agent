// Orders service owns its own database (CLAUDE.md section 8).
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id          String      @id @default(uuid())
  customerId  String
  status      String // PENDING | CONFIRMED | REJECTED | CANCELLED
  currency    String
  totalAmount Decimal     @db.Decimal(12, 2)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  sku       String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// Transactional Outbox: written in the same tx as the aggregate change.
model OutboxMessage {
  id            String    @id @default(uuid())
  eventId       String    @unique
  topic         String
  eventType     String
  eventVersion  Int
  aggregateId   String
  aggregateType String
  correlationId String
  causationId   String?
  payload       Json
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishedAt])
  @@map("outbox_messages")
}

// Inbox: processed event ids for idempotent consumption.
model ProcessedEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_events")
}
