# Valores compartidos (cada servicio define los suyos en su propio .env.example)
LOG_LEVEL=info

# Kafka (broker KRaft de un nodo, vía docker-compose)
KAFKA_BROKERS=localhost:9092

# Servicio de ejemplo (plantilla)
EXAMPLE_PORT=3001
EXAMPLE_DATABASE_URL=postgresql://app:app@localhost:5433/example?schema=public
