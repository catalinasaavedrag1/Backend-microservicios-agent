# Shared (per-service values live in each service's .env.example)
LOG_LEVEL=info

# Kafka (single-node KRaft broker from docker-compose)
KAFKA_BROKERS=localhost:9092

# Orders service
ORDERS_PORT=3001
ORDERS_DATABASE_URL=postgresql://oms:oms@localhost:5433/orders?schema=public

# Inventory service
INVENTORY_PORT=3002
INVENTORY_DATABASE_URL=postgresql://oms:oms@localhost:5434/inventory?schema=public

# Picking service
PICKING_PORT=3003
PICKING_DATABASE_URL=postgresql://oms:oms@localhost:5435/picking?schema=public
